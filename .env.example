# Copier vers .env et adapter.
# Config shop : table Postgres `config` (pas de fichier runtime).
# Import one-shot depuis un ancien config.json : python -m db.seed_config

# --- Runtime ---
# local  = machine + Cloudflare tunnel (defaut)
# cloud  = Railway / hebergeur (0.0.0.0, migrate-only)
# Auto-detect si RAILWAY_* present.
APP_ENV=local
# Surcharge host d'ecoute (sinon 127.0.0.1 en local, 0.0.0.0 en cloud)
# BIND_HOST=
# PORT=8080

# --- Postgres ---
# Cloud (Railway) : utiliser DATABASE_URL fourni par l'hebergeur.
# Local : DB_HOST / DB_PORT / … (creation auto de la base si absente).
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kfc_perso
DB_USER=postgres
DB_PASSWORD=root
# CREATE_DATABASE=0
# PGSSLMODE=require

# --- Telegram WebApp (obligatoire) ---
TELEGRAM_BOT_TOKEN=
# Fenetre anti-rejeu initData (secondes)
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600

# Webhook Bot API — recommande en cloud (Railway).
# En local : laisser commente → poll Telegram.
# TELEGRAM_WEBHOOK=1
# TELEGRAM_WEBHOOK_SECRET=une-chaine-longue-aleatoire

# URL publique HTTPS (Railway) pour setWebhook + BotFather Mini App
# PUBLIC_BASE_URL=https://xxx.up.railway.app
# SET_WEBHOOK_ON_BOOT=1

# Admin Telegram id (seed config.admin au boot si vide)
# ADMIN_TELEGRAM_ID=123456789

# --- Gunicorn (cloud) ---
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
