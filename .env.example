# Copier vers .env et adapter.
# Config shop : table Postgres `config` (pas de fichier runtime).
# Import one-shot depuis un ancien config.json : python -m db.seed_config

DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kfc_perso
DB_USER=postgres
DB_PASSWORD=root

# Telegram WebApp (obligatoire en prod)
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Dev local hors Telegram uniquement si TELEGRAM_BOT_TOKEN est VIDE.
# Des qu'un token bot est configure, ALLOW_DEV_AUTH est ignore (auth Telegram obligatoire).
# Ne jamais mettre ALLOW_DEV_AUTH=1 en production.
ALLOW_DEV_AUTH=0
